# Security headers for statically-served assets.
#
# Project root, not static/ — adapter-cloudflare throws if this file is in the assets
# directory (node_modules/@sveltejs/adapter-cloudflare/index.js:32) and appends its own
# immutable-caching block to this one at build time.
#
# Cloudflare does NOT apply these to responses generated by Worker code, and nothing in
# this app is prerendered, so every HTML page is covered by src/hooks.server.ts instead.
# Keep the two in step.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
