{
	"name": "syncticket",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.10.0",
	"scripts": {
		"dev": "vite dev",
		"dev:relay": "pnpm --filter syncticket-relay dev",
		"demo": "PUBLIC_RELAY_HOST=localhost:8791 concurrently -k -n relay,app -c magenta,cyan \"pnpm dev:relay\" \"vite dev\"",
		"build": "wrangler types && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:e2e": "playwright test",
		"test": "pnpm test:unit --run",
		"test:unit": "vitest",
		"cf-typegen": "wrangler types",
		"ci:local": "bash scripts/ci-local.sh",
		"fetch:search-assets": "node scripts/fetch-search-assets.mjs",
		"deploy": "[ -n \"$PUBLIC_RELAY_HOST\" ] || { echo 'PUBLIC_RELAY_HOST is not set — a build without it ships a permanently local-only app. See docs/DEPLOY.md.' >&2; exit 1; }; pnpm --filter syncticket-relay run deploy && pnpm build && wrangler deploy"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/geist": "^5.2.9",
		"@huggingface/transformers": "4.2.0",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.23.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"concurrently": "^10.0.5",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"fake-indexeddb": "6.2.5",
		"flexsearch": "0.8.212",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.3.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"svelte-dnd-action": "0.9.79",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"virtua": "0.51.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"fractional-indexing": "4.0.0",
		"mode-watcher": "^1.1.0",
		"y-indexeddb": "9.0.12",
		"y-partyserver": "2.2.0",
		"y-protocols": "1.0.7",
		"yjs": "13.6.31"
	}
}
